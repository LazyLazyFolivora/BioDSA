# Vertex AI
GOOGLE_API_KEY=xxxxx
GOOGLE_CLOUD_PROJECT_ID=xxxxx

# AWS Bedrock
AWS_ACCESS_KEY_ID=xxxxx
AWS_SECRET_ACCESS_KEY=xxxxx

# Anthropic Claude
ANTHROPIC_API_KEY=xxxxx

# AZURE OpenAI
AZURE_OPENAI_ENDPOINT=xxxxx
AZURE_OPENAI_API_KEY=xxxxx

# OpenAI API
OPENAI_API_KEY=sk-Ssg-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Local LLM (vLLM)
BIODSA_LLM_HOST=localhost
BIODSA_LLM_PORT=8000
BIODSA_LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
BIODSA_LLM_API_KEY=not-needed

# DeepSeek (OpenAI-compatible cloud API)
DEEPSEEK_API_KEY=xxxxx
# BIODSA_LLM_API_BASE=https://api.deepseek.com   # 取消注释以使用 DeepSeek 云端 API
# BIODSA_DISABLE_THINKING=true                    # DeepSeek V4 默认开启思考模式，设 true 关闭

# Web search backend (anthropic | tavily)
# BIODSA_WEBSEARCH_BACKEND=tavily   # 切换联网搜索后端到 Tavily
TAVILY_API_KEY=xxxxx

# BioDSA MCP Server
BIODSA_MCP_PORT=8765